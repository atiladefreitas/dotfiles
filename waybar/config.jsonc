{
    "layer": "bottom",
    "position": "bottom",
    "height": 28,
    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock",
        "custom/media",
        "cpu",
        "memory",
        "temperature"
    ],
    "modules-right": [
        "battery",
        "custom/wifi",
        "custom/audio",
        "custom/bluetooth"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "sort-by-number": true
    },

    "clock": {
        "interval": 30,
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#ffffff'><b>{}</b></span>",
                "days":     "<span color='#ffffff'>{}</span>",
                "weeks":    "<span color='#999999'>W{}</span>",
                "weekdays": "<span color='#cccccc'><b>{}</b></span>",
                "today":    "<span color='#000000' background='#ffffff'><b>{}</b></span>"
            }
        }
    },

    "custom/media": {
        "format": "{}",
        "return-type": "json",
        "max-length": 50,
        "interval": 2,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} - {{title}}\", \"alt\": \"{{status}}\", \"tooltip\": \"{{title}} ({{artist}})\", \"class\": \"{{status}}\"}' 2>/dev/null | head -n 1",
        "exec-if": "pgrep playerctld || playerctl status 2>/dev/null",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "cpu": {
        "interval": 5,
        "format": "<span size=\"large\"> </span> {usage}%",
        "tooltip": false,
        "on-click": "kitty --class waybar-popup -e btop"
    },

    "memory": {
        "interval": 5,
        "format": "<span size=\"large\"> </span> {percentage}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
        "on-click": "kitty --class waybar-popup -e btop"
    },

    "temperature": {
        "interval": 5,
        "critical-threshold": 85,
        "format": "<span size=\"large\">󰔏</span> {temperatureC}°C",
        "format-critical": "<span size=\"large\"></span>  {temperatureC}°C",
        "on-click": "kitty --class waybar-popup -e btop"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "<span size=\"large\">{icon}</span>",
        "format-charging": "<span size=\"large\"></span>  {capacity}%",
        "format-plugged": "<span size=\"large\"></span>  {capacity}%",
        "format-icons": [" ", " ", " ", " ", " "],
        "tooltip-format": "{timeTo}"
    },

    "custom/wifi": {
        "exec": "~/dotfiles/waybar/scripts/network.sh",
        "return-type": "json",
        "interval": 5,
        "format": "<span size=\"large\">{}</span>",
        "on-click": "kitty --class waybar-popup -e impala"
    },

    "custom/audio": {
        "exec": "pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk '/Volume:/ {gsub(\"%\",\"\",$5); print $5; exit}'",
        "exec-if": "command -v pactl >/dev/null",
        "interval": 2,
        "format": "<span size=\"large\">  </span>",
        "on-click": "kitty --class waybar-popup -e wiremix",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "tooltip": false
    },

    "custom/bluetooth": {
        "exec": "bluetoothctl info 2>/dev/null | awk -F': ' '/Name:/ {n=$2} /Connected: yes/ {c=1} END{ if(c) print n; else print \"off\" }'",
        "interval": 10,
        "format": "<span size=\"large\">󰂯 </span>",
        "on-click": "kitty --class waybar-popup -e bluetui",
        "tooltip": false
    }
}
